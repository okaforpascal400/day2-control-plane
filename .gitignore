__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
**/.terraform/
*.tfstate
*.tfstate.*
# Exception: the state-backend is a bootstrap stack — it creates the very
# S3 bucket + DynamoDB table that every other stack uses as its remote
# backend, so its own state cannot live in that backend (chicken-and-egg).
# We keep this one state file in git. Verified secret-free (SSE-S3, no KMS,
# no credentials in state); only public ARNs/account-id are present.
!infra/state-backend/terraform.tfstate
*.tfvars
!example.tfvars
# Fetched from the k3s node — embeds a cluster-admin client cert and key.
# Regenerate with the `kubeconfig_fetch` output of infra/aws; never commit.
kubeconfig-*
tfplan
node_modules/
dist/
.env
.env.*
*.pem
*.key
.DS_Store

# Vendored Helm subchart archives (pinned via Chart.lock; fetch with `helm dependency build`)
deploy/observability/charts/

# Originals stashed by scripts/break.sh while a failure scenario is seeded.
.break-backup/

# Agent audit trails. Written outside the workspace on a runner and uploaded as
# a run artifact (see .github/workflows/triage-agent.yml); this catches a local
# run that defaults the path into the repo.
*audit.jsonl

# Copilot answer-receipt signing key. The PRIVATE half is a secret and lives in
# ~/.config/day2-copilot/ (mode 0600) or DAY2_COPILOT_SIGNING_KEY; this entry
# catches a key that gets generated into the working tree by mistake. The
# PUBLIC half under agents/copilot/keys/*.pub is committed on purpose — a
# receipt nobody outside this machine can verify is not evidence.
*_ed25519.key
copilot_ed25519.key
